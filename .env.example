# Copy to .env and fill in. Loaded by python-dotenv (backend/app/config.py).

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# Logging (agent ReAct loop traces go to the uvicorn terminal)
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Data locations (defaults are fine; override only if needed)
# DATA_DIR=./data
# SANDBOX_DIR=./sandbox

# Frontend uses /backend proxy — see frontend/next.config.ts (no direct :8000 URL needed).
